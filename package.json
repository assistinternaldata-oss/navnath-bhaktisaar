{
  "name": "navnath-bhaktisaar",
  "version": "1.0.0",
  "private": true,
  "description": "Shri Navnath Bhaktisaar — web app plus Android and iOS apps (Capacitor)",
  "scripts": {
    "web": "node scripts/copy-web.mjs",
    "sync": "node scripts/copy-web.mjs && cap sync",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#a93a12\" --iconBackgroundColorDark \"#2a0e08\" --splashBackgroundColor \"#a93a12\" --splashBackgroundColorDark \"#14100d\"",
    "serve": "python tools/serve.py"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/tiro-devanagari-marathi": "^5.3.0"
  }
}
